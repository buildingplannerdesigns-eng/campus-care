# Public site
NEXT_PUBLIC_SITE_URL=https://www.actcampuscare.com

# Sanity CMS — create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Optional: hosted Studio URL after `npm run sanity:deploy`
NEXT_PUBLIC_SANITY_STUDIO_URL=
# Optional write token (not required for public reads / Studio login)
SANITY_API_TOKEN=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@actcampuscare.com
CONTACT_NOTIFICATION_EMAIL=info@actcampuscare.com
DR_CAMMIE_CONTACT_EMAIL=cconnor@actcampuscare.com

# Donations (Donorbox — international payments)
NEXT_PUBLIC_DONORBOX_CAMPAIGN_URL=

# Optional Campus Care drumming video (defaults to /videos/campus-care.mp4)
NEXT_PUBLIC_CAMPUS_CARE_VIDEO_URL=

# Optional homepage hero background video (defaults to /videos/home-hero.mp4)
NEXT_PUBLIC_HOME_HERO_VIDEO=
NEXT_PUBLIC_HOME_HERO_POSTER=

# Optional ACT page hero background video (defaults to /videos/act-hero.mp4)
NEXT_PUBLIC_ACT_HERO_VIDEO=
NEXT_PUBLIC_ACT_HERO_POSTER=

# Cloudflare Turnstile (contact form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (optional donation records)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
